---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const stories = await getCollection('stories', s => !s.data.draft);
---
<Base title="Plan your trip" description="Tell a Noon Wild advisor where you are drawn. We reply with ideas, seasons and a first itinerary." light>
  <section class="plan" data-theme="light">
    <div>
      <h1 class="t-display words">Tell us about your next expedition.</h1>
      <p class="lead reveal" style="--d:.3s">An advisor will reply with ideas, the best seasons and a first itinerary, built around the places and stories that pull you. There is no cost to plan.</p>
    </div>
    <form class="form reveal" style="--d:.2s" name="plan" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="plan">
      <p class="hp"><label>Leave this empty <input name="company"></label></p>
      <label>Name <input name="name" autocomplete="name" required></label>
      <label>Email <input type="email" name="email" autocomplete="email" required></label>
      <label class="full">Where are you drawn?
        <select name="interest" id="interest">
          <option value="">Choose a place or story</option>
          <option>East Africa</option><option>Yellowstone</option><option>Central America</option><option>The Arctic</option><option>Galápagos</option>
          {stories.map(s => <option value={s.data.title} data-id={s.id}>{s.data.title}</option>)}
          <option>Somewhere else</option>
        </select>
      </label>
      <label>When <input name="dates" placeholder="Month or season, year"></label>
      <label>Travelers <input name="travelers" placeholder="e.g. 2 adults"></label>
      <label class="full">Budget per person
        <select name="budget"><option value="">Prefer to discuss</option><option>Under $10,000</option><option>$10,000 to $25,000</option><option>$25,000 to $50,000</option><option>$50,000+</option></select>
      </label>
      <label class="full">Anything else <textarea name="notes" placeholder="An animal you've always wanted to see, a story that caught you, a celebration..."></textarea></label>
      <button class="btn btn-dark" type="submit">Send to an advisor</button>
    </form>
  </section>
  <script is:inline>
    const id = new URLSearchParams(location.search).get('story');
    if (id) { const o = document.querySelector(`#interest option[data-id="${id}"]`); if (o) o.selected = true; }
  </script>
</Base>
