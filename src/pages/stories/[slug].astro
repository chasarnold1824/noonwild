---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { allStories, readingTime, fmtDate } from '../../lib';

export async function getStaticPaths() {
  const stories = await getCollection('stories', s => !s.data.draft);
  return stories.map(story => ({ params: { slug: story.id }, props: { story } }));
}
const { story } = Astro.props;
const d = story.data;
const { Content, headings } = await render(story);
const toc = headings.filter(h => h.depth === 2);
const all = await allStories();
const further = d.related.map(id => all.find(s => s.id === id && !s.data.draft)).filter(Boolean);
const more = all.filter(s => s.id !== story.id).slice(0, 3);
---
<Base title={d.title} description={d.dek} image={d.image}>
  <article>
    <header class="a-hero">
      <img src={d.image} alt={d.imageAlt} style={`object-position: ${d.imagePosition}`}>
      <div class="wrap">
        <span class="caps">{d.category} · {d.region}</span>
        <h1>{d.title}</h1>
        <p class="dek">{d.dek}</p>
        <div class="byline"><span>{d.author}, {d.authorRole}</span><span>{fmtDate(d.date)}</span><span>{readingTime(story.body)} min read</span></div>
      </div>
      <span class="credit">{d.imageSourceUrl ? <a href={d.imageSourceUrl} rel="noopener" target="_blank">{d.imageCredit}</a> : d.imageCredit}</span>
    </header>

    <div class="wrap a-layout">
      <div>
        {d.keyTakeaways.length > 0 && (
          <section class="takeaways" aria-labelledby="kt-title">
            <h2 id="kt-title">Key Takeaways</h2>
            <ul>{d.keyTakeaways.map(t => <li>{t}</li>)}</ul>
          </section>
        )}
        <div class="prose"><Content /></div>
        {d.faq.length > 0 && (
          <section class="prose faq" aria-labelledby="faq-title">
            <h2 id="faq-title">What You Actually Want to Know</h2>
            {d.faq.map(f => <p><strong>{f.q}</strong><br>{f.a}</p>)}
          </section>
        )}
        <p class="prose closer">Tell a Noon Wild advisor which story pulled you in, and we will build the trip around it. <a href={`/plan/?story=${story.id}`}>Start the conversation.</a></p>
        {further.length > 0 && (
          <section class="further" aria-labelledby="fr-title">
            <h2 id="fr-title" class="caps tag">Further reading</h2>
            <ul>{further.map((s: any) => <li><a href={`/stories/${s.id}/`}>{s.data.title}</a></li>)}</ul>
          </section>
        )}
        {d.sources.length > 0 && (
          <section class="sources" aria-labelledby="src-title">
            <h2 id="src-title">Sources</h2>
            <ol>{d.sources.map(s => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ol>
          </section>
        )}
      </div>
      <aside class="aside">
        {toc.length > 0 && (
          <nav class="toc" aria-labelledby="toc-title">
            <span class="caps tag" id="toc-title">In this article</span>
            <ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {d.atAGlance.length > 0 && (
          <div class="glance">
            <span class="caps tag">At a glance</span>
            <dl>{d.atAGlance.map(i => <div><dt>{i.label}</dt><dd>{i.value}</dd></div>)}</dl>
          </div>
        )}
        <a class="btn btn--brass" href={`/plan/?story=${story.id}`}>Plan this trip</a>
      </aside>
    </div>
  </article>

  <section class="sec journal-band" aria-labelledby="more-title">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="caps tag">The journal</span><h2 id="more-title">More stories</h2></div>
        <a class="link" href="/stories/">See all stories <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="cards">{more.map(s => <StoryCard story={s} />)}</div>
    </div>
  </section>
</Base>
