---
import Base from '../layouts/Base.astro';
import RowCard from '../components/RowCard.astro';
import { allStories, unsplash, fmtDate, readingTime } from '../lib';
import { cdn } from '../img.mjs';

const stories = await allStories();
const featured = stories.find(s => s.data.featured && !s.data.draft) ?? stories[0];
const list = stories.filter(s => s !== featured).slice(0, 4);

const destinations = [
  { name: 'Rwanda', img: unsplash('photo-1722291731448-3afe029611a6', 1200), href: '/stories/rwanda-gorilla-trek/' },
  { name: 'The Pantanal', img: unsplash('photo-1595600896602-6b9052fe0c5b', 1600), pos: '52% 45%', href: '/stories/pantanal-jaguars-roosevelt/' },
  { name: 'Yellowstone', img: unsplash('photo-1778704828743-31586fcea70d', 1200), href: '/stories/yellowstone-like-hemingway/' },
  { name: 'Patagonia', img: unsplash('photo-1715356758153-6d58ae44e8fe', 1200), href: '/stories/' },
  { name: 'Galápagos', img: unsplash('photo-1706957614198-8d2e5f0ed6ea', 1200), href: '/stories/' },
  { name: 'Namibia', img: unsplash('photo-1506710507565-203b9f24669b', 1200), href: '/stories/' },
  { name: 'Antarctica', img: unsplash('photo-1551415923-a2297c7fda79', 1600), pos: '40% 55%', href: '/stories/' },
  { name: 'East Africa', img: '/img/lions-greeting.jpg', href: '/stories/' },
  { name: 'The Arctic', img: '/img/polar-bear.jpg', href: '/stories/' },
  { name: 'Central America', img: '/img/copan-stela.jpg', href: '/stories/' },
  { name: 'Uganda', img: '/img/elephant.jpg', href: '/stories/' },
];

const why = [
  { n: '01', t: 'Every trip begins with a true story', p: 'An explorer, a naturalist, a writer who went first. We start there, then build the journey that lets you stand inside it.', img: '/img/elephant.jpg', pos: '58% 40%' },
  { n: '02', t: 'Five-star camps, lodges and ships', p: 'The finest properties at the edge of the wild, with preferred benefits through Noon Travel: upgrades, credits and quiet extras.', img: '/img/tent-interior.jpg', pos: '30% 50%' },
  { n: '03', t: 'Travel that leaves the place better', p: 'Every journey comes with an impact report, so you see exactly where your trip’s conservation contribution went.', img: '/img/bighorn.jpg', pos: '50% 40%' },
];

const steps = [
  { n: '01', t: 'Choose your story.', p: 'Start with whatever pulls at you: a place you have read about for years, an explorer whose journal you could not put down, an animal you have always wanted to see in the wild. Browse the journal, or simply tell us the feeling you are after. Every Noon Wild trip begins with a true story, and yours will too.', art: 'compass' },
  { n: '02', t: 'Meet your advisor.', p: 'A real conversation, not a form. Your advisor asks how you like to travel, who is coming, how active you want the days to be and what the trip is for, then comes back with honest options: the right season, the right camp or lodge, and what each one is actually like on the ground.', art: 'map' },
  { n: '03', t: 'We design the expedition.', p: 'We build a private itinerary around your story and the finest properties at the edge of the wild, with preferred benefits through Noon Travel where they apply. Permits, bush flights, transfers and specialist guides are arranged and checked, so all that is left for you to decide is what to pack.', art: 'tent' },
  { n: '04', t: 'Travel, then see your impact.', p: 'Your advisor stays on call from the first flight to the last, ready for changes, weather and the unexpected. When you are home, you receive an impact report showing where your trip\u2019s conservation contribution went, and the people and places it now supports.', art: 'peak' },
];
---
<Base>
  <!-- HERO: Noon's blurred-backdrop carousel -->
  <section class="hero" data-theme="dark" id="destinations">
    <div class="hero-bg" aria-hidden="true">
      {destinations.map((d, i) => <img src={cdn(d.img, 1200)} alt="" class:list={{ on: i === 0 }} loading={i < 2 ? 'eager' : 'lazy'}>)}
    </div>
    <div class="hero-body">
      <p class="carousel-label enter" style="--d:.2s">Featured destinations</p>
      <div class="carousel enter" style="--d:.28s" aria-label="Featured destinations">
        {destinations.map((d, i) => (
          <a class="c-card" href={d.href} data-i={i}><img src={cdn(d.img, 800)} alt={d.name} style={`object-position:${(d as any).pos ?? '50% 50%'}`}><span>{d.name}</span></a>
        ))}
      </div>
      <h1 class="t-h1 enter" style="--d:.45s">Go where the explorers went.</h1>
      <div class="hero-actions">
        <a class="btn btn-text enter" style="--d:.88s; color:#fff" href="/stories/">Read the stories</a>
        <a class="btn btn-solid enter" style="--d:1s" href="/plan/">Get started</a>
      </div>
    </div>
  </section>

  <!-- WHY: sticky stacked image cards -->
  <section class="stack" style={`--n:${why.length}`} data-theme="dark">
    <div class="stack-sticky">
      <div class="stack-bg" aria-hidden="true"><img src="/img/lion-dusk.jpg" alt=""></div>
      <h2 class="t-display stack-head words">True stories. Five-star journeys.</h2>
      <div class="stack-cards">
        {why.map(c => (
          <article class="s-card">
            <img src={c.img} alt="" loading="lazy" style={`object-position:${c.pos}`}>
            <div class="shade"></div>
            <div class="copy"><span class="num">{c.n}</span><h3>{c.t}</h3><p>{c.p}</p></div>
            <div class="dim"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW: glass step cards -->
  <section class="stack stack--glass" style={`--n:${steps.length}`} data-theme="dark" id="how">
    <div class="stack-sticky">
      <div class="stack-bg" aria-hidden="true"><img src="/img/mammoth-snow.jpg" alt=""></div>
      <h2 class="t-display stack-head words">From first story to base camp.</h2>
      <div class="stack-cards">
        {steps.map(s => (
          <article class="s-card">
            <div class="copy"><span class="num">{s.n}</span><h3>{s.t}</h3><p>{s.p}</p></div>
            <svg class="art" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              {s.art === 'compass' && <><circle cx="60" cy="60" r="46"/><circle cx="60" cy="60" r="38" stroke-dasharray="2 4"/><path d="M60 22v8M60 90v8M22 60h8M90 60h8"/><path d="M60 34 68 60 60 86 52 60z"/><circle cx="60" cy="60" r="3"/></>}
              {s.art === 'map' && <><path d="M18 30 44 20l32 12 26-10v68l-26 10-32-12-26 10z"/><path d="M44 20v68M76 32v68"/><path d="M28 64c8-10 18 4 26-6s16 2 24-6 12-2 16-6" stroke-dasharray="3 4"/><circle cx="94" cy="44" r="4"/></>}
              {s.art === 'tent' && <><path d="M14 92h92"/><path d="M24 92 60 30l36 62"/><path d="M60 30v62M48 92l12-24 12 24"/><path d="M60 30l-6-10M60 30l6-10"/><circle cx="92" cy="28" r="7"/></>}
              {s.art === 'peak' && <><path d="M10 96 44 40l16 24 14-20 36 52z"/><path d="M38 50l6 6 6-8"/><path d="M74 44v-22l14 6-14 6"/><path d="M10 96h100"/></>}
            </svg>
            <div class="dim"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STORIES -->
  <section class="light-band sec" data-theme="light">
    <h2 class="t-display sec-title words">Stories from the wild.</h2>
    <div class="stories-grid">
      {featured && (
        <a class="feat-card reveal" href={`/stories/${featured.id}/`}>
          <img src={cdn(featured.data.image, 1600)} alt={featured.data.imageAlt} loading="lazy" style={`object-position:${featured.data.imagePosition}`}>
          <div class="in">
            <span class="pill">{featured.data.category}</span>
            <h3 class="t-feature">{featured.data.title}</h3>
            <div class="meta light"><span>{fmtDate(featured.data.date)}</span><span>•</span><span>{readingTime(featured.body)} mins read</span></div>
          </div>
        </a>
      )}
      <div class="list-col">{list.map((s, i) => <RowCard story={s} d={`${0.08 * i}s`} />)}</div>
    </div>
    <div class="center"><a class="btn btn-soft" href="/stories/">See all stories</a></div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta" data-theme="dark">
    <img src="/img/elk-snow.jpg" alt="" loading="lazy" style="object-position:55% 60%">
    <div class="in">
      <h2 class="t-display words">Tell us about your next expedition.</h2>
      <a class="btn btn-solid reveal" style="--d:.3s" href="/plan/">Get started</a>
    </div>
  </section>

  <script>
    // Hero carousel: Noon-style centered rotation with blurred backdrop crossfade
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.c-card'));
    const bgs = Array.from(document.querySelectorAll<HTMLElement>('.hero-bg img'));
    let active = 0, timer: number | undefined;
    const n = cards.length;
    function render() {
      cards.forEach((c, i) => {
        let o = i - active;
        if (o > n / 2) o -= n; if (o < -n / 2) o += n;
        const a = Math.abs(o);
        c.style.setProperty('--o', String(o));
        c.style.setProperty('--s', a === 0 ? '1.28' : String(1 - a * 0.06));
        c.style.setProperty('--op', a > 3 ? '0' : a === 3 ? '.35' : String(1 - a * 0.12));
        c.style.zIndex = String(10 - a);
        c.classList.toggle('active', a === 0);
        c.tabIndex = a > 2 ? -1 : 0;
      });
      bgs.forEach((b, i) => b.classList.toggle('on', i === active));
    }
    const next = () => { active = (active + 1) % n; render(); };
    const start = () => { clearInterval(timer); timer = window.setInterval(next, 4200); };
    cards.forEach((c, i) => c.addEventListener('click', e => {
      if (i !== active) { e.preventDefault(); active = i; render(); start(); }
    }));
    render(); start();
  </script>
</Base>
