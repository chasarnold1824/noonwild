---
// Full-bleed travel montage: short cuts from free-license Pexels footage
// (pexels.com/license), streamed from Pexels' CDN and crossfaded in the browser.
const V = 'https://videos.pexels.com/video-files/';
const clips = [
  { src: '38750356/16464950_1280_720_60fps.mp4', at: 2, label: 'Mountain gorillas, Rwanda' },
  { src: '39730323/16941596_1280_720_30fps.mp4', at: 2, label: 'Torres del Paine, Chile' },
  { src: '8849308/8849308-hd_1280_720_24fps.mp4', at: 2, label: 'Inside a tented suite' },
  { src: '13402251/13402251-hd_1280_720_25fps.mp4', at: 2, label: 'On the trail to Everest Base Camp' },
  { src: '29171868/12597608_1280_720_30fps.mp4', at: 1, label: 'Elephants at sunset' },
  { src: '5699039/5699039-hd_1280_720_25fps.mp4', at: 2, label: 'A bath with a view' },
  { src: '35646306/15106051_1280_720_30fps.mp4', at: 2, label: 'Mount Kilimanjaro, Tanzania' },
  { src: '11236995/11236995-hd_1280_720_30fps.mp4', at: 2, label: 'On a game drive' },
  { src: '36867544/15619023_1280_720_30fps.mp4', at: 1, label: 'An infinity pool above the forest' },
  { src: '36657221/15540466_1280_720_24fps.mp4', at: 2, label: 'Into the rainforest' },
  { src: '18680289/18680289-hd_1280_720_25fps.mp4', at: 3, label: 'A humpback breaching' },
  { src: '28549037/12417116_1280_720_25fps.mp4', at: 2, label: 'A jungle lodge from above' },
  { src: '39664522/16908283_1280_720_60fps.mp4', at: 2, label: 'Climbers on a summit ridge' },
  { src: '6299773/6299773-hd_1280_720_30fps.mp4', at: 1, label: 'By expedition boat, among the ice' },
  { src: '8849306/8849306-hd_1280_720_24fps.mp4', at: 2, label: 'Sundowners at camp' },
  { src: '39157033/16662850_1280_720_25fps.mp4', at: 1, label: 'Cheetah on the savanna' },
  { src: '9130066/9130066-hd_1280_720_30fps.mp4', at: 2, label: 'Trekking in the Himalayas' },
  { src: '16106215/16106215-hd_1280_720_60fps.mp4', at: 2, label: 'A plunge pool in the jungle' },
  { src: '29632693/12750545_1280_720_25fps.mp4', at: 2, label: 'Ama Dablam, Nepal' },
  { src: '14556448/14556448-hd_1280_720_30fps.mp4', at: 1, label: 'Zebras, Masai Mara' },
  { src: '4022224/4022224-hd_1280_720_50fps.mp4', at: 2, label: 'Overwater villas, the Maldives' },
  { src: '17075145/17075145-hd_1280_720_30fps.mp4', at: 2, label: 'Walking the glacier' },
  { src: '11971111/11971111-hd_1280_720_30fps.mp4', at: 2, label: 'Champagne at sunset' },
  { src: '17983734/17983734-hd_1280_720_30fps.mp4', at: 6, label: 'Sunrise over the Brandberg, Namibia' },
  { src: '39514343/16833996_1280_720_30fps.mp4', at: 2, label: 'A lodge lit up at night' },
  { src: '31280471/13358079_1280_720_25fps.mp4', at: 1, label: 'The northern lights' },
  { src: '35728732/15142595_1280_720_60fps.mp4', at: 3, label: 'A summit push at sunset' },
  { src: '4996250/4996250-hd_1280_720_30fps.mp4', at: 2, label: 'A campfire in the forest' },
  { src: '39576516/16868146_1280_720_30fps.mp4', at: 1, label: 'A lakeside terrace at dusk' },
].map(c => ({ ...c, src: V + c.src }));
---
<section class="montage" data-theme="dark" aria-label="Noon Wild travel montage">
  <div class="montage-stage" aria-hidden="true">
    <video class="m-vid is-on" muted playsinline preload="none" poster="/img/lion-dusk.jpg"></video>
    <video class="m-vid" muted playsinline preload="none"></video>
    <div class="m-shade"></div>
    <div class="m-bar m-bar-top"></div><div class="m-bar m-bar-bot"></div>
  </div>
  <div class="montage-copy container">
    <p class="m-kicker reveal">Noon Wild</p>
    <h2 class="t-h1 words">The world, still wild.</h2>
    <p class="m-sub reveal" style="--d:.25s">Gorillas in the mist, ice that calves into the sea, a fire under a sky full of stars, and a five-star bed at the end of the day.</p>
    <a class="btn btn-solid reveal" style="--d:.35s" href="/plan/">Plan your expedition</a>
  </div>
  <div class="montage-foot container">
    <span class="m-label" aria-live="off"></span>
    <span class="m-bars" aria-hidden="true">{clips.map(() => <i></i>)}</span>
    <span class="m-credit">Footage: Pexels</span>
  </div>
  <script type="application/json" id="montage-clips" set:html={JSON.stringify(clips)}></script>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.montage');
  if (root) {
    const clips: { src: string; at: number; label: string }[] = JSON.parse(document.getElementById('montage-clips')!.textContent!);
    const [a, b] = Array.from(root.querySelectorAll<HTMLVideoElement>('.m-vid'));
    const label = root.querySelector<HTMLElement>('.m-label')!;
    const bars = Array.from(root.querySelectorAll<HTMLElement>('.m-bars i'));
    const CUT = 1800; // ms per shot
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let n = 0, front = a, back = b, timer: number | undefined, running = false, gen = 0, lastShown = -1e9;

    // Load a clip and seek to its in-point. Resolves true only once a real frame is decoded at the in-point,
    // false if it is not ready in time (that shot is then skipped, so nothing ever flashes half-loaded).
    const prime = (v: HTMLVideoElement, k: number) => new Promise<boolean>(res => {
      const c = clips[k];
      let done = false;
      const finish = (ok: boolean) => { if (done) return; done = true; res(ok); };
      const seek = () => {
        if (Math.abs(v.currentTime - c.at) < 0.05 && !v.seeking) return finish(true);
        v.addEventListener('seeked', () => finish(true), { once: true });
        try { v.currentTime = c.at; } catch { finish(false); }
      };
      if (v.dataset.k !== String(k)) { v.dataset.k = String(k); v.preload = 'auto'; v.src = c.src; }
      if (v.readyState >= 2) seek(); else v.addEventListener('loadeddata', seek, { once: true });
      setTimeout(() => finish(false), 4000);
    });

    async function loop(g: number) {
      if (!running || g !== gen) return;
      let ok = await prime(back, n);
      // If this shot is slow, try the next one instead of showing a blank or a stale frame.
      for (let tries = 0; !ok && tries < 3 && g === gen; tries++) { n = (n + 1) % clips.length; ok = await prime(back, n); }
      // Never cut before the current shot has held for the full beat, whatever woke the loop.
      const hold = CUT - (performance.now() - lastShown);
      if (hold > 0) await new Promise(r => setTimeout(r, hold));
      if (!running || g !== gen) return;
      if (ok) {
        lastShown = performance.now();
        back.play().catch(() => {});
        back.classList.add('is-on'); front.classList.remove('is-on');
        
        [front, back] = [back, front];
        label.textContent = clips[n].label;
        bars.forEach((el, x) => el.classList.toggle('on', x === n));
      }
      n = (n + 1) % clips.length;
      const shown = performance.now();
      // Let the outgoing shot finish fading before loading the next clip into it, so it never flashes.
      new Promise(r => setTimeout(r, 450)).then(() => g === gen ? prime(back, n) : false).then(() => {
        // Each shot holds for the full cut, measured from when it actually appeared.
        const wait = Math.max(0, CUT - (performance.now() - shown));
        if (g === gen) timer = window.setTimeout(() => loop(g), wait);
      });
    }
    function start() { if (running || reduce) return; running = true; gen++; loop(gen); }
    function stop() { running = false; gen++; clearTimeout(timer); a.pause(); b.pause(); }
    new IntersectionObserver(es => es.forEach(e => e.isIntersecting ? start() : stop()), { threshold: 0.2 }).observe(root);
    let visible = false;
    new IntersectionObserver(es => es.forEach(e => { visible = e.isIntersecting; }), { threshold: 0.2 }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (visible) start(); });
  }
</script>
