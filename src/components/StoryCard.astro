---
import { fmtDate, readingTime } from '../lib';
import { cdn } from '../img.mjs';
interface Props { story: any; }
const { story } = Astro.props;
const d = story.data;
const Tag = d.draft ? 'div' : 'a';
---
<Tag class:list={['card', 'reveal', { soon: d.draft }]} href={d.draft ? undefined : `/stories/${story.id}/`} data-cat={d.category}>
  <div class="thumb">
    <img src={cdn(d.image, 900)} alt={d.imageAlt} loading="lazy" style={`object-position: ${d.imagePosition}`}>
    <span class="pill">{d.category}</span>
  </div>
  <h3 class="t-title">{d.title}</h3>
  <div class="meta">{d.draft ? <span class="soon-tag">Coming soon</span> : <><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time><span aria-hidden="true">•</span><span>{readingTime(story.body)} mins read</span></>}</div>
</Tag>
