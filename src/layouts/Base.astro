---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/dm-sans/opsz.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; light?: boolean; }
const {
  title,
  description = "Private, five-star journeys to the world's wildest places, and the true stories behind them. An affiliate of Noon Travel.",
  image = '/img/lion-dusk.jpg',
  light = false,
} = Astro.props;
const fullTitle = title ? `${title} | Noon Wild` : 'Noon Wild | Go where the explorers went.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/img/mark.png">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1E3126">
</head>
<body class:list={['noise', { light }]}>
  <header class:list={['site-header', light ? 'over-light' : 'over-dark']} id="site-header">
    <div class="site-header-inner">
      <a class="logo enter-logo" href="/" aria-label="Noon Wild home">
        <img class="logo-light" src="/img/logo-light.png" alt="Noon Wild">
        <img class="logo-dark" src="/img/logo-dark.png" alt="">
      </a>
      <nav class="header-nav enter-logo" aria-label="Main">
        <a class="btn btn-text" href="/stories/">Stories</a>
        <a class="btn btn-text" href="/destinations/">Destinations</a>
        <a class="btn btn-solid" href="/plan/">Get started</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer" data-theme="dark">
    <div class="foot">
      <div>
        <img class="foot-logo" src="/img/logo-light.png" alt="Noon Wild">
        <p>Luxury journeys to the world's wildest places, and the true stories behind them. An affiliate of Noon Travel.</p>
        <div class="socials">
          <a href="https://www.instagram.com/" aria-label="Instagram" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
          <a href="mailto:hello@noonwild.com" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></a>
        </div>
      </div>
      <div><h4>Connect.</h4><ul><li><a href="/plan/">Plan your trip</a></li><li><a href="mailto:hello@noonwild.com">Contact us</a></li><li><a href="https://noontravel.com" rel="noopener">Noon Travel</a></li></ul></div>
      <div><h4>Resources.</h4><ul><li><a href="/stories/">Stories</a></li><li><a href="/destinations/">Destinations</a></li><li><a href="/#how">How it works</a></li></ul></div>
    </div>
    <p class="fine">© {new Date().getFullYear()} Noon Wild. An affiliate of Noon Travel. All rights reserved.</p>
    <p class="fine">Video courtesy of Pexels, and of Gregory “Slobirdr” Smith (Pantanal jaguar, <a href="https://commons.wikimedia.org/wiki/File:Pantanal_Jaguar_(Panthera_onca).webm" rel="noopener">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/2.0/" rel="noopener">CC BY-SA 2.0</a>).</p>
  </footer>

  <script>
    // Header: compact on scroll; light/dark by the section under it (Noon's behaviour).
    const header = document.getElementById('site-header')!;
    const themed = () => Array.from(document.querySelectorAll<HTMLElement>('[data-theme]'));
    const defaultLight = document.body.classList.contains('light');
    function updateHeader() {
      header.classList.toggle('is-compact', window.scrollY > 24);
      const y = header.offsetHeight / 2;
      let theme = defaultLight ? 'light' : 'dark';
      for (const el of themed()) {
        const r = el.getBoundingClientRect();
        if (r.top <= y && r.bottom > y) theme = el.dataset.theme!;
      }
      header.classList.toggle('over-light', theme === 'light');
      header.classList.toggle('over-dark', theme !== 'light');
    }
    addEventListener('scroll', updateHeader, { passive: true });
    addEventListener('resize', updateHeader);
    updateHeader();

    // Blur-in word headings
    document.querySelectorAll<HTMLElement>('.words').forEach(el => {
      const words = (el.textContent || '').trim().split(/\s+/);
      el.setAttribute('aria-label', words.join(' '));
      el.innerHTML = words.map((w, i) => `<span class="w" aria-hidden="true" style="--i:${i}">${w}</span>`).join(' ');
    });

    // Reveal on scroll
    const io = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal, .words').forEach(el => io.observe(el));

    // Sticky stacked cards
    const stacks = Array.from(document.querySelectorAll<HTMLElement>('.stack'));
    function updateStacks() {
      if (innerWidth < 768) return;
      for (const s of stacks) {
        const cards = Array.from(s.querySelectorAll<HTMLElement>('.s-card'));
        const r = s.getBoundingClientRect();
        const total = s.offsetHeight - innerHeight;
        const p = Math.min(Math.max(-r.top / total, 0), 1) * (cards.length - 1 + 0.35);
        cards.forEach((c, i) => {
          const enter = Math.min(Math.max(p - (i - 1), 0), 1);      // 0..1 as card i slides in
          const depth = Math.max(p - i, 0);                          // how far behind the front it is
          const y = i === 0 ? 0 : (1 - easeOut(enter)) * innerHeight;
          const scale = 1 - Math.min(depth, 3) * 0.05;
          const lift = Math.min(depth, 3) * -22;
          c.style.transform = `translate3d(0, ${y + lift}px, 0) scale(${scale})`;
          c.style.zIndex = String(i + 1);
          const dim = c.querySelector<HTMLElement>('.dim');
          if (dim) dim.style.opacity = String(Math.min(depth, 1) * 0.55);
        });
      }
    }
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    addEventListener('scroll', () => requestAnimationFrame(updateStacks), { passive: true });
    addEventListener('resize', updateStacks);
    updateStacks();

    // Story hero parallax
    const px = document.querySelector<HTMLElement>('.story-hero .px');
    if (px && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      addEventListener('scroll', () => { if (scrollY < innerHeight * 1.2) px.style.transform = `translate3d(0, ${scrollY * 0.18}px, 0)`; }, { passive: true });
    }
  </script>
</body>
</html>
